{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dated literature and statement check",
  "type": "object",
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "checked_on": {"type": "string", "format": "date"},
    "status_before": {"type": "string", "minLength": 1},
    "status_after": {"type": "string", "minLength": 1},
    "statement_assessment": {"enum": ["matched", "corrected", "needs_clarification"]},
    "previous_statement": {"type": "string", "minLength": 1},
    "coverage": {"enum": ["statement_and_later_literature", "statement_only", "access_limited"]},
    "search_queries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "search_scope": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1}
        },
        "required": ["source_id", "locator", "finding"],
        "additionalProperties": false
      }
    },
    "conclusion": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
  },
  "required": ["id", "problem_id", "checked_on", "status_before", "status_after", "statement_assessment", "coverage", "search_queries", "search_scope", "evidence", "conclusion", "limitations"],
  "additionalProperties": false
}
