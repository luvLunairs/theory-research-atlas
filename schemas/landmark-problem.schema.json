{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical problem collection entry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status_basis": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "string",
      "enum": [
        "millennium",
        "hilbert"
      ]
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "partly_open",
        "formulation_dependent",
        "claimed_resolution_under_review",
        "broad_program",
        "independence"
      ]
    },
    "problem_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "last_checked": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "id",
    "title",
    "scope",
    "status_basis",
    "source_locator",
    "collection",
    "number",
    "status",
    "problem_ids",
    "source_ids",
    "last_checked"
  ],
  "additionalProperties": false
}
