{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification run",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VER-[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "specification_id": {
      "type": "string",
      "pattern": "^VSPEC-[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "specification_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^ATT-[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "attempt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "enum": [
            "contributor",
            "project",
            "independent"
          ]
        }
      },
      "required": [
        "name",
        "role",
        "provenance"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "inconclusive",
        "error"
      ]
    },
    "result_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "certificate_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "log_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "inconclusive"
            ]
          },
          "evidence_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "result",
          "evidence_artifacts",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "axioms_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "native_decide_used": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "artifact_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "reference",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "change"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "specification_id",
    "specification_digest",
    "problem_id",
    "attempt_id",
    "attempt_digest",
    "executed_at",
    "runner",
    "command",
    "outcome",
    "result_artifacts",
    "certificate_artifacts",
    "log_artifacts",
    "checks",
    "axioms_used",
    "native_decide_used",
    "limitations",
    "evidence_artifacts",
    "artifact_manifest",
    "revision_history"
  ],
  "additionalProperties": false,
  "description": "A retained verification execution and its evidence. No acceptance or human-review label is stored in this record."
}
