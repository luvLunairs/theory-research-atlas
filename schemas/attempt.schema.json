{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attempt",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ATT-[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "provider",
        "name",
        "version",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "planned",
        "running",
        "stopped",
        "completed",
        "failed"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "code_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "os",
        "tools",
        "versions",
        "code_revision",
        "seeds"
      ],
      "additionalProperties": false
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "process_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "planned_budget": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "estimate",
            "cap"
          ]
        },
        "money": {
          "type": "object",
          "properties": {
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "currency",
            "basis"
          ],
          "additionalProperties": false
        },
        "compute_units": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "money",
        "compute_units",
        "human_hours",
        "notes"
      ],
      "additionalProperties": false
    },
    "actual_use": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "actual"
          ]
        },
        "money": {
          "type": "object",
          "properties": {
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "amount",
            "currency",
            "basis"
          ],
          "additionalProperties": false
        },
        "compute_units": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "money",
        "compute_units",
        "human_hours",
        "notes"
      ],
      "additionalProperties": false
    },
    "human_help": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "candidate_answer_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "review_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "change"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "statement_version": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable statement snapshot, dated record with checksum, or repository revision reviewed for this attempt."
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Exact scoped claim and assumptions addressed by this attempt."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "research",
        "method_calibration",
        "model_evaluation"
      ]
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "outcome_kind": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "not_yet_reported",
        "unsuccessful",
        "reproduction",
        "partial_result",
        "candidate_answer",
        "correction",
        "retraction"
      ]
    },
    "stopping_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "verification_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "requirements": {
      "type": "object",
      "properties": {
        "experiment": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "compute": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "experiment",
        "data",
        "compute"
      ],
      "additionalProperties": false
    },
    "preliminary_screening": {
      "type": "object",
      "description": "Optional attributed preliminary screening, separate from scientific review and verification. Preserve stale bindings as history.",
      "properties": {
        "target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "result_artifacts": {
          "type": "array", "minItems": 1,
          "description": "Screened candidate answers, supporting artifacts and screening evidence; each entry copies the examined manifest version and digest.",
          "items": {
            "type": "object",
            "properties": {
              "reference": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            },
            "required": ["reference", "version", "sha256"],
            "additionalProperties": false
          }
        },
        "evidence_artifacts": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ai_basis": {"type": "string", "enum": ["recommended_only", "other_or_unknown", "no_ai"]},
        "ai_check_status": {"type": "string", "enum": ["completed", "not_recorded"]},
        "human_preliminary_status": {"type": "string", "enum": ["passed", "changes_requested", "not_recorded"]},
        "recorded_by": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "required": ["target_digest", "result_artifacts", "evidence_artifacts", "ai_basis", "ai_check_status", "human_preliminary_status", "recorded_by", "date", "scope", "limitations"],
      "additionalProperties": false
    },
    "artifact_manifest": {
      "type": "array",
      "items": {
        "$ref": "artifact.schema.json"
      },
      "minItems": 0,
      "description": "One retained version and integrity record for each distinct artifact reference."
    }
  },
  "required": [
    "id",
    "problem_id",
    "model",
    "started_at",
    "ended_at",
    "status",
    "environment",
    "input_artifacts",
    "process_artifacts",
    "planned_budget",
    "actual_use",
    "human_help",
    "candidate_answer_artifacts",
    "outcome",
    "limitations",
    "review_ids",
    "revision_history",
    "statement_version",
    "target",
    "purpose",
    "contributors",
    "outcome_kind",
    "stopping_conditions",
    "assumptions",
    "success_criteria",
    "verification_plan",
    "requirements",
    "artifact_manifest"
  ],
  "additionalProperties": false
}
