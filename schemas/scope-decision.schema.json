{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scope Decision",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task_class": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "include",
        "include_conditional",
        "defer",
        "exclude_current_index"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "task_class",
    "decision",
    "reason"
  ],
  "additionalProperties": false
}
